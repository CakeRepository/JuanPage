{
  "name": "juanpager",
  "version": "1.0.0",
  "description": "Machine-native meaning transport and one trusted adaptive human interface runtime",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist-sdk/index.js",
  "types": "./dist-sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-sdk/index.d.ts",
      "import": "./dist-sdk/index.js"
    },
    "./protocol": {
      "types": "./dist-sdk/protocol/meaning.d.ts",
      "import": "./dist-sdk/protocol/meaning.js"
    },
    "./transport": {
      "types": "./dist-sdk/transport/adapters.d.ts",
      "import": "./dist-sdk/transport/adapters.js"
    },
    "./adapters": {
      "types": "./dist-sdk/adapters/index.d.ts",
      "import": "./dist-sdk/adapters/index.js"
    }
  },
  "files": [
    "dist-sdk",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:sdk",
    "build:sdk": "tsc -p tsconfig.sdk.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.js",
    "check:one-runtime": "tsx scripts/enforce-one-runtime.ts",
    "benchmark:m1": "tsx scripts/benchmark-m1.ts",
    "encode": "tsx scripts/encode.ts",
    "decode": "tsx scripts/decode.ts",
    "prepack": "npm run build:sdk && npm test"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^8.57.1",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
